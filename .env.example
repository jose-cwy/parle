# NeonDB connection (Postgres) — use SSL in production
DATABASE_URL=postgresql://user:password@db-host:5432/heartstrings

# JWT secret for session tokens (required in production)
JWT_SECRET=change_this_to_a_strong_secret

# Salt for hashing guest IPs in usage_tracking (random string)
IP_HASH_SALT=change_this_to_a_random_string

# AES-256 key for journal/chat encryption at rest (32 bytes, base64-encoded)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Comma-separated allowed browser origins (production)
# ALLOWED_ORIGINS=https://parle.com,https://www.parle.com

# Resend API key
RESEND_API_KEY=your_resend_api_key

# Sender for parlé guest check-in emails (requires verified domain in Resend)
# PARLE_FROM_EMAIL=parlé <hello@parle.chat>

# Secret for cron endpoints (required in production — guest email follow-ups fail closed without it)
CRON_SECRET=your_cron_secret

# Neon API token for creating rehearsal child branches (never commit the value)
# NEON_API_KEY=

# Child-branch URL for rehearsal only (never use this as DATABASE_URL)
# REHEARSAL_DATABASE_URL=

# App URL for email links
APP_URL=http://localhost:3000

# OpenAI (required for real chat replies — server-side only)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Extra private planning call before the visible reply. Default off (Phase 2).
# Set to on only if you want the extra latency and cost.
# PARLE_HIDDEN_THINK=off

# Founder insights allowlist (server-only, never exposed to the client)
# ADMIN_EMAILS=you@parle.chat

# Extra emails excluded from official metrics (in addition to *@parle.test)
# METRICS_EXCLUDE_EMAILS=

# UTC date when verified D1/D7 cohorts begin (server message_sent after this)
# PARLE_ANALYTICS_VERIFIED_FROM=2026-10-20
